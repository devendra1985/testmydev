<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender (keep existing behavior) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Splunk HEC appender -->
    <appender name="SPLUNK" class="com.splunk.logging.HttpEventCollectorLogbackAppender">
        <url>http://localhost:8088</url>
        <token>my-hec-token</token>
        <source>testmydev</source>
        <sourcetype>spring-boot</sourcetype>
        <index>main</index>
        <messageFormat>text</messageFormat>
        <batch_size_count>10</batch_size_count>
        <batch_interval>1000</batch_interval>
        <disableCertificateValidation>true</disableCertificateValidation>
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </layout>
    </appender>

    <!-- App-specific logger -->
    <logger name="com.example.testmydev" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SPLUNK"/>
    </logger>

    <!-- Spring Web logger -->
    <logger name="org.springframework.web" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SPLUNK"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
